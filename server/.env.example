# yc-voice-agent-hackathon - Environment Variables
# Copy this file to .env and fill in your API keys

# Twilio (Transport)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Gradium (TTS + voice cloning)
GRADIUM_API_KEY=
# Default fallback voice (used when cloned voice is not configured)
GRADIUM_VOICE_ID=
# Owner's cloned voice — get the ID from gradium.ai → Voices after recording a sample.
# NEVER set this to a caller's voice. Owner-only.
GRADIUM_CLONED_VOICE_ID=
# Must be explicitly set to true to activate the cloned voice (consent guard).
OWNER_VOICE_CONSENT=false

# OpenAI (LLM)
OPENAI_API_KEY=

# NVIDIA Nemotron ASR (STT)
NVIDIA_ASR_URL=

# NVIDIA Nemotron LLM
NEMOTRON_LLM_URL=
NEMOTRON_LLM_MODEL=
NEMOTRON_LLM_API_KEY=
# Set to true to enable Nemotron chain-of-thought reasoning for urgency triage.
# The voice pipeline LLM always runs thinking=off (speed + TTS safety).
# Triage oracle fires in the background from capture_message_reason and resolves
# inside capture_urgency; full reasoning trace is logged at INFO level.
NEMOTRON_ENABLE_THINKING=true