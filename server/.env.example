# yc-voice-agent-hackathon - Environment Variables
# Copy this file to .env and fill in your API keys

# Twilio (Transport + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that calls AND texts are sent from (E.164 format, e.g. +14155550100)
TWILIO_PHONE_NUMBER=
# The owner's personal number that receives SMS summaries — DEMO: your own number only
OWNER_PHONE_NUMBER=

# Email summaries (Resend — API key, no SMTP password)
# Get a key at resend.com → API Keys. Free tier ~100/day.
RESEND_API_KEY=
# The owner's inbox that receives voicemail summary emails.
OWNER_EMAIL=
# Sender address. Default onboarding@resend.dev needs no domain setup but can ONLY
# deliver to your own Resend account email. To email any recipient, verify a
# domain in Resend and set this to an address on it (e.g. voicemail@yourdomain.com).
EMAIL_FROM=onboarding@resend.dev

# Gradium (TTS + voice cloning)
GRADIUM_API_KEY=
# Default fallback voice (used when cloned voice is not configured)
GRADIUM_VOICE_ID=
# Owner's cloned voice — get the ID from gradium.ai → Voices after recording a sample.
# NEVER set this to a caller's voice. Owner-only.
GRADIUM_CLONED_VOICE_ID=
# Must be explicitly set to true to activate the cloned voice (consent guard).
OWNER_VOICE_CONSENT=false

# OpenAI (LLM)
OPENAI_API_KEY=

# NVIDIA Nemotron ASR (STT)
NVIDIA_ASR_URL=

# NVIDIA Nemotron LLM
NEMOTRON_LLM_URL=
NEMOTRON_LLM_MODEL=
NEMOTRON_LLM_API_KEY=
# Set to true to enable Nemotron chain-of-thought reasoning for urgency triage.
# The voice pipeline LLM always runs thinking=off (speed + TTS safety).
# Triage oracle fires in the background from capture_message_reason and resolves
# inside capture_urgency; full reasoning trace is logged at INFO level.
NEMOTRON_ENABLE_THINKING=true

# --- Cekura eval harness (Person 2) ---
# The Python harness runs MOCK mode only and needs none of these. Real Cekura
# provisioning/runs are driven by the Cekura MCP tools in-session; the key for
# those must be configured on the MCP server (not just here). Get a key from
# app.cekura.ai > Settings > API Keys.
CEKURA_API_KEY=
CEKURA_BASE_URL=https://api.cekura.ai
# Optional: an OWNED project id from the dashboard URL. Never auto-derive the
# project from a foreign scenario -- a non-owned project returns 403 on writes.
CEKURA_PROJECT_ID=
# LLM engine for the eval harness: auto | ollama | openai | stub
# (auto = Ollama on compute-box -> localhost -> OpenAI -> offline stub)
CEKURA_EVAL_ENGINE=auto
# Override the local model used in mock mode (default qwen2.5:7b, fast lane)
OLLAMA_MODEL=qwen2.5:7b
# --- Cekura production observability (cekura_observe.py) ---
# Set to 1 or true to POST each completed call to Cekura on disconnect; blank = offline (local dev default).
CEKURA_OBSERVE=
# Cekura agent id for observability ingestion; env wins over eval/cekura_ids.json fallback.
CEKURA_AGENT_ID=18080
# Full URL override for the ingestion endpoint; blank = https://api.cekura.ai/observability/v1/observe/
CEKURA_OBSERVE_URL=

# Email + Calendar (owner outbound only — see MCP_AGENTS.md)
# The only outbound email/calendar target for the demo.
OWNER_EMAIL=
# 16-char Gmail app password (https://myaccount.google.com/apppasswords).
# When set with OWNER_EMAIL, actions.py sends real inbox email via SMTP.
# Without it, email is queued to the outbox and drained via the Gmail MCP
# (create_draft only). Gmail + Google Calendar MCP are connected via OAuth in
# the agent client (e.g. Cursor Settings → MCP) — never via committed config.
GMAIL_APP_PASSWORD=
# Optional Gmail sender account; defaults to OWNER_EMAIL.
GMAIL_SENDER=
# Owner timezone for callback slot scheduling.
OWNER_TZ=America/Los_Angeles

# --- Google Calendar OAuth (owner self-connect via the setup wizard) ---
# Google OAuth uses the same client id/secret for Calendar and Gmail. The owner
# clicks "Connect Google Calendar" / "Connect Gmail" in setup; the backend
# stores separate refresh tokens for each service.
# Setup: create an OAuth 2.0 "Web application" client at
#   https://console.cloud.google.com/apis/credentials
# enable the Google Calendar API and Gmail API, and add these EXACT redirect
# URIs to the client:
#   http://localhost:8787/api/calendar/google/callback
#   http://localhost:8787/api/gmail/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client above.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/calendar/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8787/api/gmail/google/callback
# Where the stored refresh token lives (default: server/google_token.json).
GOOGLE_TOKEN_PATH=
# Where the Gmail refresh token lives (default: server/google_gmail_token.json).
GOOGLE_GMAIL_TOKEN_PATH=
# Web app origin the OAuth popup posts back to (default http://localhost:5173).
WEB_APP_URL=http://localhost:5173

# Persistence backend (voicemails + Cekura eval runs)
# Resolution order: DynamoDB → S3 JSON → local file. Leave unset for local file.
PERSIST_DDB_TABLE=
PERSIST_S3_BUCKET=
PERSIST_S3_PREFIX=
PERSIST_LOCAL_PATH=

# Cloud persona context
# The cleaned derived persona is uploaded after `python -m ingest.refresh`.
# At bot startup, cloud is checked first so Pipecat Cloud and other machines
# can share one persona without copying persona_context.md into the container.
PERSONA_CLOUD_ENABLED=true
# Set true in production if a missing cloud record should disable local fallback.
PERSONA_CLOUD_REQUIRED=false
# Optional overrides; defaults reuse the persistence DynamoDB table / S3 bucket.
PERSONA_CLOUD_DDB_TABLE=
PERSONA_CLOUD_S3_BUCKET=
PERSONA_CLOUD_S3_PREFIX=personas/
# Optional stable record key override. Default is derived from owner tag/email.
PERSONA_CLOUD_RECORD_ID=
