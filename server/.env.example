# yc-voice-agent-hackathon - Environment Variables
# Copy this file to .env and fill in your API keys

# Twilio (Transport + SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number that calls AND texts are sent from (E.164 format, e.g. +14155550100)
TWILIO_PHONE_NUMBER=
# Voice webhook path on PUBLIC_BASE_URL for newly assigned tenant numbers.
TWILIO_VOICE_PATH=/
# The owner's personal number that receives SMS summaries — DEMO: your own number only
OWNER_PHONE_NUMBER=

# Email summaries (Resend — API key, no SMTP password)
# Get a key at resend.com → API Keys. Free tier ~100/day.
RESEND_API_KEY=
# The owner's inbox that receives voicemail summary emails.
OWNER_EMAIL=
# Sender address. Default onboarding@resend.dev needs no domain setup but can ONLY
# deliver to your own Resend account email. To email any recipient, verify a
# domain in Resend and set this to an address on it (e.g. voicemail@yourdomain.com).
EMAIL_FROM=onboarding@resend.dev

# Gradium (TTS + voice cloning)
GRADIUM_API_KEY=
# Default fallback voice (used when cloned voice is not configured)
GRADIUM_VOICE_ID=
# Owner's cloned voice — get the ID from gradium.ai → Voices after recording a sample.
# NEVER set this to a caller's voice. Owner-only.
GRADIUM_CLONED_VOICE_ID=
# Must be explicitly set to true to activate the cloned voice (consent guard).
OWNER_VOICE_CONSENT=false
# Advanced Gradium TTS controls. These match Gradium's wire-level json_config:
# negative padding bonus is faster; higher temp is more variable; higher cfg is
# more similar to the cloned voice. PCM output is fixed at 48 kHz by the adapter.
GRADIUM_TTS_PADDING_BONUS=0.0
GRADIUM_TTS_TEMP=0.7
GRADIUM_TTS_CFG_COEF=2.0

# OpenAI (optional low-latency audio-input + text-LLM voicemail path)
OPENAI_API_KEY=
# Live voice provider: nemotron | openai-realtime
VOICE_LLM_PROVIDER=nemotron
# OpenAI Realtime settings. The low-latency path replaces the cascade STT and
# Nemotron LLM, but keeps Gradium TTS so the owner's cloned voice still speaks.
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_REASONING_EFFORT=minimal
OPENAI_REALTIME_VAD_EAGERNESS=high

# NVIDIA Nemotron ASR (STT)
NVIDIA_ASR_URL=

# --- Cascade STT engine (VOICE_LLM_PROVIDER=nemotron path) ---
# openai | gradium | nvidia. "openai" uses gpt-4o-transcribe with a proper-noun
# prompt bias — best at names and unusual words ("Stanford waitlist", "grape").
STT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
# Comma-separated proper nouns to bias recognition toward (names, brands, slang).
STT_EXTRA_TERMS=Stanford,waitlist,grape
# On the openai-realtime path, set the transcription model to gpt-4o-transcribe
# (it honors the proper-noun prompt; gpt-realtime-whisper largely ignores it).
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Owner developer/social tools (owner_tools.py) ---
# Treat the live speaker as the owner (unlocks github / inbox / list reminders).
# Set to 1 for local dev (you talking to your own agent). On a deployed phone
# line leave unset; access is then granted only when the caller number matches
# OWNER_PHONE_NUMBER. add_reminder is always allowed (callers can leave reminders).
ASSISTANT_MODE=
# GitHub PAT (fine-grained or classic). Unlocks open PRs + unread notifications;
# without it only public activity for GITHUB_USERNAME is visible.
GITHUB_TOKEN=
# Pins the GitHub account; auto-resolved from the token when omitted.
GITHUB_USERNAME=
# macOS Reminders works automatically when the bot runs on a Mac (osascript).
# First use prompts for Automation permission in System Settings.

# NVIDIA Nemotron LLM
NEMOTRON_LLM_URL=
NEMOTRON_LLM_MODEL=
NEMOTRON_LLM_API_KEY=
# Set to true to enable Nemotron chain-of-thought reasoning for urgency triage.
# The voice pipeline LLM always runs thinking=off (speed + TTS safety).
# Triage oracle fires in the background from capture_message_reason and resolves
# inside capture_urgency; full reasoning trace is logged at INFO level.
NEMOTRON_ENABLE_THINKING=true

# --- Cekura eval harness (Person 2) ---
# The Python harness runs MOCK mode only and needs none of these. Real Cekura
# provisioning/runs are driven by the Cekura MCP tools in-session; the key for
# those must be configured on the MCP server (not just here). Get a key from
# app.cekura.ai > Settings > API Keys.
CEKURA_API_KEY=
CEKURA_BASE_URL=https://api.cekura.ai
# Optional: an OWNED project id from the dashboard URL. Never auto-derive the
# project from a foreign scenario -- a non-owned project returns 403 on writes.
CEKURA_PROJECT_ID=
# LLM engine for the eval harness: auto | ollama | openai | stub
# (auto = Ollama on compute-box -> localhost -> OpenAI -> offline stub)
CEKURA_EVAL_ENGINE=auto
# Override the local model used in mock mode (default qwen2.5:7b, fast lane)
OLLAMA_MODEL=qwen2.5:7b
# --- Cekura production observability (cekura_observe.py) ---
# Set to 1 or true to POST each completed call to Cekura on disconnect; blank = offline (local dev default).
CEKURA_OBSERVE=
# Cekura agent id for observability ingestion; env wins over eval/cekura_ids.json fallback.
CEKURA_AGENT_ID=18080
# Full URL override for the ingestion endpoint; blank = https://api.cekura.ai/observability/v1/observe/
CEKURA_OBSERVE_URL=

# Email + Calendar (owner outbound only — see MCP_AGENTS.md)
# The only outbound email/calendar target for the demo.
OWNER_EMAIL=
# 16-char Gmail app password (https://myaccount.google.com/apppasswords).
# When set with OWNER_EMAIL, actions.py sends real inbox email via SMTP.
# Without it, email is queued to the outbox and drained via the Gmail MCP
# (create_draft only). Gmail + Google Calendar MCP are connected via OAuth in
# the agent client (e.g. Cursor Settings → MCP) — never via committed config.
GMAIL_APP_PASSWORD=
# Optional Gmail sender account; defaults to OWNER_EMAIL.
GMAIL_SENDER=
# Owner timezone for callback slot scheduling.
OWNER_TZ=America/Los_Angeles

# --- Google Calendar OAuth (owner self-connect via the setup wizard) ---
# Google OAuth uses the same client id/secret for Calendar and Gmail. The owner
# clicks "Connect Google Calendar" / "Connect Gmail" in setup; the backend
# stores separate refresh tokens for each service.
# Setup: create an OAuth 2.0 "Web application" client at
#   https://console.cloud.google.com/apis/credentials
# enable the Google Calendar API and Gmail API, and add these EXACT redirect
# URIs to the client:
#   http://localhost:8787/api/calendar/google/callback
#   http://localhost:8787/api/gmail/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client above.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/calendar/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8787/api/gmail/google/callback
# Where the stored refresh token lives (default: server/google_token.json).
GOOGLE_TOKEN_PATH=
# Where the Gmail refresh token lives (default: server/google_gmail_token.json).
GOOGLE_GMAIL_TOKEN_PATH=
# Web app origin the OAuth popup posts back to (default http://localhost:5173).
# In split-origin public onboarding, set this to the Vercel frontend URL while
# PUBLIC_BASE_URL points at the voice/API backend.
WEB_APP_URL=http://localhost:5173
# Public deploy switch. When set (e.g. a cloudflared tunnel URL), the API serves
# the built frontend AND its own /api on this single origin, and OAuth redirect
# URIs are derived from it: <PUBLIC_BASE_URL>/api/calendar/google/callback and
# /api/gmail/google/callback (add both to your Google OAuth client). Leave blank
# for local dev. Set automatically by scripts/serve-public.sh.
PUBLIC_BASE_URL=
# Voice-worker deploy switch. When true, bot-nemotron.py attaches onboarding
# /api/* routes to the same Pipecat FastAPI runner that serves Twilio POST /
# and /ws. This lets one public voice origin also be VITE_ONBOARDING_API_URL.
ENABLE_ONBOARDING_API_ON_VOICE_WORKER=false
# The streamlined onboarding wizard can create owner clones and write live
# runtime settings only on a private, trusted deployment. Leave false for the
# public marketing site so visitors receive browser-only drafts.
ALLOW_OWNER_PROVISIONING=false

# --- Multi-user cloud onboarding ---
# Enable only on an authenticated/rate-limited backend deployment. The public
# Vercel marketing site leaves this off until its VITE_ONBOARDING_API_URL points
# at that backend. Tenant records use DynamoDB when available and never store
# raw voice audio or raw diction replies.
ENABLE_PUBLIC_TENANT_ONBOARDING=false
# Paid Gradium operation: keep separate so anonymous drafts cannot spend credits.
ENABLE_PUBLIC_VOICE_CLONING=false
# Admin-only capability used after a paid Twilio number is assigned to a tenant.
ONBOARDING_ADMIN_KEY=
# Optional self-serve assignment from pre-purchased Twilio numbers. When enabled,
# new tenant sessions get the first free number in this comma-separated pool and
# the webhook is pointed at PUBLIC_BASE_URL automatically.
ENABLE_AUTO_AGENT_PHONE_ASSIGNMENT=false
TENANT_AGENT_PHONE_POOL=
# Optional self-serve routing without buying one Twilio number per tenant. When
# enabled, activation assigns the shared forwarding number to each tenant and
# runtime routes forwarded calls by Twilio's ForwardedFrom field. Carrier support
# for ForwardedFrom can vary, so keep a phone-call acceptance test in the rollout.
ENABLE_SHARED_FORWARDING_ROUTING=false
SHARED_FORWARDING_PHONE_NUMBER=
# Optional paid self-serve purchase. Leave off unless the backend is authenticated,
# rate-limited, and allowed to spend Twilio credits. When true and no pool number
# is available, tenant activation searches Twilio Local inventory, buys one
# number, points its Voice webhook at PUBLIC_BASE_URL, then assigns it to the
# tenant.
ENABLE_AUTO_AGENT_PHONE_PURCHASE=false
TWILIO_AUTO_PURCHASE_DAILY_LIMIT=3
TWILIO_AUTO_PURCHASE_REQUIRE_CLOUD=true
TWILIO_AUTO_PURCHASE_COUNTRY=US
# Optional; defaults to the owner's NANP area code when possible.
TWILIO_AUTO_PURCHASE_AREA_CODE=
TWILIO_AUTO_PURCHASE_CONTAINS=
TWILIO_AUTO_PURCHASE_NEAR_NUMBER=
TWILIO_AUTO_PURCHASE_NEAR_OWNER=true
# Address-required numbers are skipped by default because they need extra
# regulatory information before they are safely callable.
TWILIO_ALLOW_ADDRESS_REQUIRED_PURCHASE=false
# DynamoDB table for tenant records; defaults to PERSIST_DDB_TABLE.
TENANT_STORE_DDB_TABLE=
# Production should require DynamoDB rather than silently writing local disk.
TENANT_STORE_REQUIRE_CLOUD=false
# Production voice workers should refuse unknown Twilio numbers rather than
# loading the legacy demo owner as a fallback.
TENANT_RUNTIME_REQUIRE_MATCH=false
# Tenant Google OAuth uses the same GOOGLE_CLIENT_ID/SECRET, but different
# callback paths. Add these too when PUBLIC_BASE_URL is set:
#   <PUBLIC_BASE_URL>/api/onboarding/google/gmail/callback
#   <PUBLIC_BASE_URL>/api/onboarding/google/calendar/callback
# Token storage: local for dev, Secrets Manager for cloud.
TENANT_GOOGLE_TOKEN_STORE=local
TENANT_GOOGLE_SECRET_PREFIX=gotchu/tenant-google
TENANT_GOOGLE_TOKEN_FORCE_LOCAL=false
TENANT_GOOGLE_TOKEN_LOCAL_PATH=

# Persistence backend (voicemails + Cekura eval runs)
# Resolution order: DynamoDB → S3 JSON → local file. Leave unset for local file.
PERSIST_DDB_TABLE=
PERSIST_S3_BUCKET=
PERSIST_S3_PREFIX=
PERSIST_LOCAL_PATH=

# Cloud persona context
# The cleaned derived persona is uploaded after `python -m ingest.refresh`.
# At bot startup, cloud is checked first so Pipecat Cloud and other machines
# can share one persona without copying persona_context.md into the container.
PERSONA_CLOUD_ENABLED=true
# Set true in production if a missing cloud record should disable local fallback.
PERSONA_CLOUD_REQUIRED=false
# Optional overrides; defaults reuse the persistence DynamoDB table / S3 bucket.
PERSONA_CLOUD_DDB_TABLE=
PERSONA_CLOUD_S3_BUCKET=
PERSONA_CLOUD_S3_PREFIX=personas/
# Optional stable record key override. Default is derived from owner tag/email.
PERSONA_CLOUD_RECORD_ID=
